# Automatic tiers: free OpenCode models first, then Gemini/Anthropic, then local Ollama.
LLM_PROVIDER=auto
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MONTHLY_SOFT_LIMIT_USD=15
LLM_MONTHLY_HARD_LIMIT_USD=20
LLM_HAIKU_INPUT_LIMIT=80000

# Explicit provider/model/endpoint overrides. Ollama URLs must be loopback.
LLM_MODEL=
LLM_BASE_URL=

# Optional existing manual providers.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Required for manual paid models absent from src/budget.ts (USD per 1M tokens).
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Personalisation. Set DW_ASSISTANT_NAME locally (e.g. "Steve") to keep your
# preferred system prompt; the app defaults to a generic phrasing.
DW_ASSISTANT_NAME=

AUTO_MEMORY=false
